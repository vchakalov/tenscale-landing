{
  "name": "tenscale-landing",
  "version": "1.0.0",
  "private": true,
  "description": "tenscale.ai: the Tenscale marketing site, landing pages and thank-you page, served by a Cloudflare Worker",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vchakalov/tenscale-landing.git"
  },
  "homepage": "https://tenscale.ai",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "deploy:cf": "next build && wrangler deploy",
    "preview:cf": "next build && wrangler dev",
    "test": "vitest run"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "16.2.1",
    "posthog-js": "^1.438.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260923.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1",
    "wrangler": "^4.134.0"
  }
}
